{
  "name": "openporte-release-tooling",
  "private": true,
  "description": "Release-preparation scripts for the OpenPorte WordPress plugin. See docs/release-preparation.md.",
  "scripts": {
    "lint:phpcs": "vendor/bin/phpcs -q --report=full",
    "lint:phpmd": "bash bin/lint/phpmd.sh",
    "lint:phpstan": "bash bin/lint/phpstan.sh",
    "release:version": "bash bin/release/version.sh",
    "release:i18n": "bash bin/release/i18n.sh",
    "release:assets": "bash bin/release/sync-wordpress-org-assets.sh",
    "release:check": "bash bin/release/check.sh",
    "release:dist": "bash bin/release/dist.sh",
    "release:tag": "bash bin/release/tag.sh",
    "altcha:update": "bash bin/release/altcha-update.sh",
    "altcha:verify": "bash bin/release/altcha-verify.sh"
  }
}
