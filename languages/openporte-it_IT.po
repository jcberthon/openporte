#. Plugin Name of the plugin
#: openporte.php includes/admin.php:16
msgid "OpenPorte Spam Protection"
msgstr "OpenPorte Spam Protection"

#. Description of the plugin
#: openporte.php
msgid ""
"OpenPorte is a free, open-source CAPTCHA alternative that offers robust spam "
"and bot protection without using cookies, ensuring full GDPR compliance by "
"design. A community-maintained fork of the ALTCHA Spam Protection plugin "
"(v1)."
msgstr ""
"OpenPorte è un'alternativa gratuita e open-source al CAPTCHA che offre una "
"protezione robusta contro spam e bot senza l'uso di cookie, garantendo la "
"piena conformità al GDPR per progettazione. Un fork mantenuto dalla comunità "
"del plugin ALTCHA Spam Protection (v1)."

