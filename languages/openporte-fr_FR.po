#. Plugin Name of the plugin
#: openporte.php includes/admin.php:16
msgid "OpenPorte Spam Protection"
msgstr "OpenPorte Spam Protection"

#. Description of the plugin
#: openporte.php
msgid ""
"OpenPorte is a free, open-source CAPTCHA alternative that offers robust spam "
"and bot protection without using cookies, ensuring full GDPR compliance by "
"design. A community-maintained fork of the ALTCHA Spam Protection plugin "
"(v1)."
msgstr ""
"OpenPorte est une alternative gratuite et open-source au CAPTCHA qui offre "
"une protection robuste contre le spam et les robots, sans utiliser de "
"cookies, garantissant ainsi une conformité totale au RGPD par conception. Un "
"fork maintenu par la communauté du plugin ALTCHA Spam Protection (v1)."

