#. translators: %s: link to the OpenPorte plugin page.
#: openporte.php:45
#, php-format
msgid ""
"OpenPorte is a fork of ALTCHA Spam Protection and cannot run while the "
"original ALTCHA plugin is active — the two share internal code. Please "
"deactivate \"ALTCHA Spam Protection\" first, then activate OpenPorte. See "
"the %s for details."
msgstr ""
"OpenPorte — це форк ALTCHA Spam Protection і не може працювати, поки "
"активний оригінальний плагін ALTCHA — вони мають спільний внутрішній код. "
"Будь ласка, спочатку деактивуйте \"ALTCHA Spam Protection\", а потім "
"активуйте OpenPorte. Деталі за посиланням %s."

#: openporte.php:66
msgid "OpenPorte cannot be activated"
msgstr "OpenPorte не вдається активувати"

#: openporte.php:77
msgid "Go to the Plugins page"
msgstr "Перейти на сторінку плагінів"

#~ msgid ""
#~ "OpenPorte is an open-source anti-spam plugin that protects sites from "
#~ "bots using a lightweight Proof-of-Work challenge instead of CAPTCHAs."
#~ msgstr ""
#~ "OpenPorte — це плагін захисту від спаму з відкритим вихідним кодом, який "
#~ "захищає сайти від ботів, використовуючи легке завдання Proof-of-Work "
#~ "замість CAPTCHA."

#~ msgid ""
#~ "OpenPorte is a free, open-source CAPTCHA alternative that offers robust "
#~ "spam and bot protection without using cookies, ensuring full GDPR "
#~ "compliance by design. A community-maintained fork of the ALTCHA Spam "
#~ "Protection plugin (v1)."
#~ msgstr ""
#~ "OpenPorte — це безкоштовна альтернатива CAPTCHA з відкритим кодом, яка "
#~ "забезпечує надійний захист від спаму та ботів без використання cookies, "
#~ "що гарантує відповідність GDPR за дизайном. Це форк плагіна ALTCHA Spam "
#~ "Protection (v1), який підтримується спільнотою."
