#. Plugin Name of the plugin
#: openporte.php includes/admin.php:16
msgid "OpenPorte Spam Protection"
msgstr "OpenPorte Spam Protection"

#. Description of the plugin
#: openporte.php
msgid ""
"OpenPorte is a free, open-source CAPTCHA alternative that offers robust spam "
"and bot protection without using cookies, ensuring full GDPR compliance by "
"design. A community-maintained fork of the ALTCHA Spam Protection plugin "
"(v1)."
msgstr ""
"OpenPorte — це безкоштовна альтернатива CAPTCHA з відкритим кодом, яка "
"забезпечує надійний захист від спаму та ботів без використання cookies, що "
"гарантує відповідність GDPR за дизайном. Це форк плагіна ALTCHA Spam "
"Protection (v1), який підтримується спільнотою."

