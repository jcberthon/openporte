#. Plugin Name of the plugin
#: openporte.php includes/admin.php:16
msgid "OpenPorte Spam Protection"
msgstr "OpenPorte Spam Protection"

#. Description of the plugin
#: openporte.php
msgid ""
"OpenPorte is a free, open-source CAPTCHA alternative that offers robust spam "
"and bot protection without using cookies, ensuring full GDPR compliance by "
"design. A community-maintained fork of the ALTCHA Spam Protection plugin "
"(v1)."
msgstr ""
"OpenPorte este o alternativă gratuită, open-source la CAPTCHA, care oferă o "
"protecție robustă împotriva spam-ului și a bot-urilor fără a folosi cookie-"
"uri, asigurând conformitatea completă cu GDPR prin design. Un fork menținut "
"de comunitate al plugin-ului ALTCHA Spam Protection (v1)."

