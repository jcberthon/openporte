#: openporte.php:45
#, php-format
msgid ""
"OpenPorte is a fork of ALTCHA Spam Protection and cannot run while the "
"original ALTCHA plugin is active — the two share internal code. Please "
"deactivate \"ALTCHA Spam Protection\" first, then activate OpenPorte. See "
"the %s for details."
msgstr ""
"OpenPorte to fork ALTCHA Spam Protection i nie może działać, gdy oryginalna "
"wtyczka ALTCHA jest aktywna — obie dzielą wewnętrzny kod. Prosimy o "
"deaktywację \"ALTCHA Spam Protection\", a następnie aktywację OpenPorte. "
"Zobacz %s po szczegóły."

#: openporte.php:66
msgid "OpenPorte cannot be activated"
msgstr "Nie można aktywować OpenPorte"

#: openporte.php:77
msgid "Go to the Plugins page"
msgstr "Przejdź do strony Wtyczek"

#~ msgid ""
#~ "OpenPorte is an open-source anti-spam plugin that protects sites from "
#~ "bots using a lightweight Proof-of-Work challenge instead of CAPTCHAs."
#~ msgstr ""
#~ "OpenPorte to wtyczka antyspamowa o otwartym kodzie źródłowym, która "
#~ "chroni strony przed botami, korzystając z lekkiego wyzwania Proof-of-Work "
#~ "zamiast CAPTCHA."

#~ msgid ""
#~ "OpenPorte is a free, open-source CAPTCHA alternative that offers robust "
#~ "spam and bot protection without using cookies, ensuring full GDPR "
#~ "compliance by design. A community-maintained fork of the ALTCHA Spam "
#~ "Protection plugin (v1)."
#~ msgstr ""
#~ "OpenPorte to bezpłatna, open-source'owa alternatywa dla CAPTCHA, która "
#~ "zapewnia skuteczną ochronę przed spamem i botami bez użycia plików "
#~ "cookie, gwarantując pełną zgodność z RODO od podstaw. Fork utrzymywany "
#~ "przez społeczność wtyczki ALTCHA Spam Protection (v1)."
